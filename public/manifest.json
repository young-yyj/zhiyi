{
  "manifest_version": 3,
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "name": "__MSG_app_name__",
  "description": "__MSG_app_description__",
  "version": "1.0.1.0",
  "key": "",
  "default_locale": "en",
  "author": "Gabe<yugang2002@gmail.com>",
  "homepage_url": "https://github.com/fishjar/kiss-translator",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "<all_urls>",
        "file://*/*"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injector-subtitle.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    },
    {
      "resources": [
        "injector-shadowroot.js",
        "api/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+K"
      }
    },
    "toggleTranslate": {
      "suggested_key": {
        "default": "Alt+Z"
      },
      "description": "__MSG_toggle_translate__"
    },
    "toggleTranbox": {
      "description": "__MSG_toggle_tranbox__"
    },
    "toggleTranslateOnly": {
      "description": "__MSG_toggle_translate_only__"
    },
    "openTranbox": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "__MSG_open_tranbox__"
    },
    "openSeparateWindow": {
      "suggested_key": {
        "default": "Alt+D"
      },
      "description": "__MSG_open_separate_window__"
    },
    "toggleStyle": {
      "description": "__MSG_toggle_style__"
    },
    "imageScreenshot": {
      "description": "__MSG_image_screenshot_command__"
    },
    "openOptions": {
      "description": "__MSG_open_options__"
    }
  },
  "permissions": [
    "storage",
    "offscreen",
    "tts",
    "contextMenus",
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_permissions": [
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "images/logo16.png",
    "32": "images/logo32.png",
    "48": "images/logo48.png",
    "128": "images/logo128.png"
  },
  "action": {
    "default_icon": {
      "128": "images/logo128.png"
    },
    "default_title": "__MSG_app_name__",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
